{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "2.0.0.0",
  "metadata": {
    "_description": "Deploys the Custom Claim Matching Function App on the Azure Functions Flex Consumption plan. Flex Consumption provides always-ready instances that eliminate cold-start latency — required to stay within the ~2s Entra Custom Authentication Extension call budget. Application code is NOT deployed by this template; publish it separately with `func azure functionapp publish <functionAppName>` or via your CI pipeline."
  },
  "parameters": {
    "functionAppName": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60,
      "metadata": {
        "description": "Name of the Azure Function App. Must be globally unique."
      }
    },
    "storageAccountType": {
      "type": "string",
      "defaultValue": "Standard_LRS",
      "allowedValues": [
        "Standard_LRS",
        "Standard_GRS",
        "Standard_RAGRS"
      ],
      "metadata": {
        "description": "Storage account SKU for the Function App."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources. Flex Consumption is not available in every region — see https://learn.microsoft.com/azure/azure-functions/flex-consumption-plan#regional-availability"
      }
    },
    "alwaysReadyInstances": {
      "type": "int",
      "defaultValue": 1,
      "minValue": 0,
      "maxValue": 20,
      "metadata": {
        "description": "Number of pre-warmed instances kept ready for the http trigger group. 1 is enough to eliminate cold-start ACAEM_CALL_ERROR for the CAE workload; increase if you expect concurrent CAE calls > ~10/sec."
      }
    },
    "instanceMemoryMB": {
      "type": "int",
      "defaultValue": 2048,
      "allowedValues": [
        512,
        2048,
        4096
      ],
      "metadata": {
        "description": "Per-instance memory in MB for Flex Consumption. 2048 is a good default for .NET isolated workloads."
      }
    },
    "maximumInstanceCount": {
      "type": "int",
      "defaultValue": 40,
      "minValue": 40,
      "maxValue": 1000,
      "metadata": {
        "description": "Maximum scale-out instance count for the Flex Consumption plan."
      }
    },
    "excelShareUrl": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "HTTP(S) URL to the Excel file (OneDrive link, Azure Blob SAS URL, or any web-hosted .xlsx). Required only when using the excel provider."
      }
    },
    "excelSheetName": {
      "type": "string",
      "defaultValue": "Sheet1",
      "metadata": {
        "description": "Worksheet name in the Excel file (defaults to Sheet1)."
      }
    },
    "excelCacheMinutes": {
      "type": "int",
      "defaultValue": 5,
      "metadata": {
        "description": "Minutes to cache the parsed Excel data in memory (defaults to 5)."
      }
    },
    "claimsValidatorProvider": {
      "type": "string",
      "defaultValue": "excel",
      "allowedValues": [
        "excel",
        "hrapi"
      ],
      "metadata": {
        "description": "Claims validation provider. Use 'excel' for testing with an Excel file, or 'hrapi' for production with an HR REST API."
      }
    },
    "hrApiBaseUrl": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Base URL of your HR REST API (for example, https://hr.contoso.com/api). Required only when using the hrapi provider."
      }
    },
    "hrApiAuthMode": {
      "type": "string",
      "defaultValue": "",
      "allowedValues": [
        "",
        "apikey",
        "oauth"
      ],
      "metadata": {
        "description": "Authentication mode for the HR API: 'apikey' or 'oauth'. Leave empty when using the excel provider."
      }
    },
    "hrApiApiKey": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "API key for the HR API (required when hrApiAuthMode is 'apikey'). Leave empty otherwise."
      }
    },
    "hrApiOAuthScope": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "OAuth scope for the HR API (for example, api://hr-api-app-id/.default). Required when hrApiAuthMode is 'oauth'."
      }
    },
    "entraIdTenantId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Entra ID tenant ID for OAuth 2.0 Bearer token validation. Leave empty to disable."
      }
    },
    "entraIdClientId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Entra ID application (client) ID of the Function App's app registration for OAuth 2.0. Leave empty to disable."
      }
    },
    "dotnetVersion": {
      "type": "string",
      "defaultValue": "10.0",
      "allowedValues": [
        "8.0",
        "10.0"
      ],
      "metadata": {
        "description": "The .NET version for the Function App runtime (dotnet-isolated). Defaults to 10.0."
      }
    },
    "packageUrl": {
      "type": "string",
      "defaultValue": "https://github.com/rogulati/AccountRecoveryClaimsMatchingAPI/releases/latest/download/release.zip",
      "metadata": {
        "description": "Public URL to the pre-built Function App release zip. Defaults to the latest GitHub Release of this repo. Override to deploy from a fork or a specific version (e.g. .../releases/download/v1.2.3/release.zip)."
      }
    }
  },
  "variables": {
    "hostingPlanName": "[concat(parameters('functionAppName'), '-plan')]",
    "storageAccountName": "[concat(take(toLower(replace(replace(replace(parameters('functionAppName'), '-', ''), '_', ''), ' ', '')), 10), take(uniqueString(resourceGroup().id), 8), 'sa')]",
    "applicationInsightsName": "[concat(parameters('functionAppName'), '-ai')]",
    "deploymentContainerName": "app-package",
    "deployerIdentityName": "[concat(parameters('functionAppName'), '-deployer')]",
    "deploymentScriptName": "[concat(parameters('functionAppName'), '-publish-code')]",
    "storageBlobDataOwnerRoleId": "b7e6dc6d-f1e8-4753-8033-0f276bb0955b",
    "storageBlobDataOwnerRoleDefinitionId": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Authorization/roleDefinitions/', variables('storageBlobDataOwnerRoleId'))]",
    "websiteContributorRoleId": "de139f84-1756-47ae-9be6-808fbbe84772",
    "websiteContributorRoleDefinitionId": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Authorization/roleDefinitions/', variables('websiteContributorRoleId'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[variables('storageAccountName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[parameters('storageAccountType')]"
      },
      "kind": "StorageV2",
      "properties": {
        "supportsHttpsTrafficOnly": true,
        "minimumTlsVersion": "TLS1_2",
        "allowBlobPublicAccess": false,
        "defaultToOAuthAuthentication": true,
        "allowSharedKeyAccess": false
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices",
      "apiVersion": "2023-05-01",
      "name": "[concat(variables('storageAccountName'), '/default')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ],
      "properties": {}
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-05-01",
      "name": "[concat(variables('storageAccountName'), '/default/', variables('deploymentContainerName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', variables('storageAccountName'), 'default')]"
      ],
      "properties": {
        "publicAccess": "None"
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[variables('applicationInsightsName')]",
      "location": "[parameters('location')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "Request_Source": "rest"
      }
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2024-04-01",
      "name": "[variables('hostingPlanName')]",
      "location": "[parameters('location')]",
      "sku": {
        "tier": "FlexConsumption",
        "name": "FC1"
      },
      "kind": "functionapp",
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2024-04-01",
      "name": "[parameters('functionAppName')]",
      "location": "[parameters('location')]",
      "kind": "functionapp,linux",
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('hostingPlanName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', variables('storageAccountName'), 'default', variables('deploymentContainerName'))]",
        "[resourceId('Microsoft.Insights/components', variables('applicationInsightsName'))]"
      ],
      "properties": {
        "enabled": true,
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('hostingPlanName'))]",
        "httpsOnly": true,
        "clientAffinityEnabled": false,
        "keyVaultReferenceIdentity": "SystemAssigned",
        "functionAppConfig": {
          "deployment": {
            "storage": {
              "type": "blobContainer",
              "value": "[concat('https://', variables('storageAccountName'), '.blob.', environment().suffixes.storage, '/', variables('deploymentContainerName'))]",
              "authentication": {
                "type": "SystemAssignedIdentity"
              }
            }
          },
          "runtime": {
            "name": "dotnet-isolated",
            "version": "[parameters('dotnetVersion')]"
          },
          "scaleAndConcurrency": {
            "alwaysReady": [
              {
                "name": "http",
                "instanceCount": "[parameters('alwaysReadyInstances')]"
              }
            ],
            "maximumInstanceCount": "[parameters('maximumInstanceCount')]",
            "instanceMemoryMB": "[parameters('instanceMemoryMB')]"
          }
        },
        "siteConfig": {
          "minTlsVersion": "1.2",
          "ftpsState": "Disabled",
          "http20Enabled": true,
          "appSettings": [
            {
              "name": "AzureWebJobsStorage__accountName",
              "value": "[variables('storageAccountName')]"
            },
            {
              "name": "AzureWebJobsStorage__credential",
              "value": "managedidentity"
            },
            {
              "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
              "value": "[reference(resourceId('Microsoft.Insights/components', variables('applicationInsightsName')), '2020-02-02').ConnectionString]"
            },
            {
              "name": "Excel__ShareUrl",
              "value": "[parameters('excelShareUrl')]"
            },
            {
              "name": "Excel__SheetName",
              "value": "[parameters('excelSheetName')]"
            },
            {
              "name": "Excel__CacheMinutes",
              "value": "[string(parameters('excelCacheMinutes'))]"
            },
            {
              "name": "ClaimsValidator__Provider",
              "value": "[parameters('claimsValidatorProvider')]"
            },
            {
              "name": "EntraId__TenantId",
              "value": "[parameters('entraIdTenantId')]"
            },
            {
              "name": "EntraId__ClientId",
              "value": "[parameters('entraIdClientId')]"
            },
            {
              "name": "HrApi__BaseUrl",
              "value": "[parameters('hrApiBaseUrl')]"
            },
            {
              "name": "HrApi__AuthMode",
              "value": "[parameters('hrApiAuthMode')]"
            },
            {
              "name": "HrApi__ApiKey",
              "value": "[parameters('hrApiApiKey')]"
            },
            {
              "name": "HrApi__OAuthScope",
              "value": "[parameters('hrApiOAuthScope')]"
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), parameters('functionAppName'), variables('storageBlobDataOwnerRoleId'))]",
      "scope": "[concat('Microsoft.Storage/storageAccounts/', variables('storageAccountName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('functionAppName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[variables('storageBlobDataOwnerRoleDefinitionId')]",
        "principalId": "[reference(resourceId('Microsoft.Web/sites', parameters('functionAppName')), '2024-04-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[variables('deployerIdentityName')]",
      "location": "[parameters('location')]"
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.Web/sites', parameters('functionAppName')), variables('deployerIdentityName'), variables('websiteContributorRoleId'))]",
      "scope": "[concat('Microsoft.Web/sites/', parameters('functionAppName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('functionAppName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('deployerIdentityName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[variables('websiteContributorRoleDefinitionId')]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('deployerIdentityName')), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "type": "Microsoft.Resources/deploymentScripts",
      "apiVersion": "2023-08-01",
      "name": "[variables('deploymentScriptName')]",
      "location": "[parameters('location')]",
      "kind": "AzureCLI",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('deployerIdentityName'))]": {}
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('functionAppName'))]",
        "[extensionResourceId(resourceId('Microsoft.Web/sites', parameters('functionAppName')), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.Web/sites', parameters('functionAppName')), variables('deployerIdentityName'), variables('websiteContributorRoleId')))]"
      ],
      "properties": {
        "azCliVersion": "2.61.0",
        "timeout": "PT15M",
        "retentionInterval": "PT1H",
        "cleanupPreference": "OnSuccess",
        "environmentVariables": [
          { "name": "PACKAGE_URL", "value": "[parameters('packageUrl')]" },
          { "name": "RG", "value": "[resourceGroup().name]" },
          { "name": "FUNCTION_APP", "value": "[parameters('functionAppName')]" }
        ],
        "scriptContent": "set -e\necho \"Downloading $PACKAGE_URL\"\nwget -q -O /tmp/app.zip \"$PACKAGE_URL\"\necho \"Downloaded $(stat -c %s /tmp/app.zip) bytes\"\necho \"Publishing to function app $FUNCTION_APP in resource group $RG\"\naz functionapp deployment source config-zip --resource-group \"$RG\" --name \"$FUNCTION_APP\" --src /tmp/app.zip --build-remote false --timeout 600\necho \"Deployment complete.\"\n"
      }
    }
  ],
  "outputs": {
    "functionAppName": {
      "type": "string",
      "value": "[parameters('functionAppName')]"
    },
    "functionAppUrl": {
      "type": "string",
      "value": "[concat('https://', parameters('functionAppName'), '.azurewebsites.net')]"
    },
    "functionAppPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', parameters('functionAppName')), '2024-04-01', 'full').identity.principalId]"
    },
    "storageAccountName": {
      "type": "string",
      "value": "[variables('storageAccountName')]"
    },
    "deploymentInstructions": {
      "type": "string",
      "value": "[concat('Code is deployed automatically from ', parameters('packageUrl'), '. To redeploy with a different version, re-run the template with a new packageUrl, or run: func azure functionapp publish ', parameters('functionAppName'))]"
    },
    "functionEndpoint": {
      "type": "string",
      "value": "[concat('https://', parameters('functionAppName'), '.azurewebsites.net/api/CustomClaimMatching')]"
    }
  }
}
